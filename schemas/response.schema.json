{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "category",
    "needs_review",
    "missing_fields",
    "reply"
  ],
  "properties": {
    "category": {
      "enum": [
        "billing",
        "access",
        "other"
      ]
    },
    "needs_review": {
      "type": "boolean"
    },
    "missing_fields": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "order_id",
          "days_since_delivery"
        ]
      }
    },
    "reply": {
      "type": "string",
      "minLength": 1
    }
  }
}